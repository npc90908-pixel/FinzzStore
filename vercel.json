{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "server.js": {
      "includeFiles": [
        "public/**",
        "views/**"
      ],
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/poll",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/reconcile",
      "schedule": "0 3 * * *"
    }
  ]
}
