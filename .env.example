# ============================================================================
# FINZZ Store — environment template (ringkas)
#
# Copy ke .env untuk lokal, atau set sebagai environment variable di host
# (Vercel/VPS). Hanya variabel di file ini yang perlu dipikirkan operator.
# Opsi lain (pool database, TTL, interval job, batas ukuran, nama cookie, dll.)
# memakai bawaan aman di src/config.js; README.md menjelaskan pengaturan utama.
#
# Aturan emas:
#   · secret/kredensial di sini hanya dibaca server; API publik hanya merilis
#     site key Turnstile (publik by design) dan status integrasi yang non-rahasia;
#   · fitur opsional hidup OTOMATIS ketika kredensialnya diisi, dan hilang
#     dari UI ketika kosong — tidak ada flag ENABLED yang harus disinkronkan;
#   · produksi menolak boot tanpa DATABASE_URL, APP_ENCRYPTION_KEY dan
#     CRON_SECRET (lihat src/config.js).
# ============================================================================

# ============================== APP ========================================
NODE_ENV=development                 # development | production | test
APP_URL=http://localhost:3000        # wajib https:// di produksi
# 32 byte acak, base64 — generate dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# ============================== DATABASE ====================================
# PostgreSQL langsung (driver pg). Supabase hanya dipakai sebagai host Postgres;
# Supabase Auth tidak dipakai. Untuk runtime Vercel, gunakan Supabase Transaction
# Pooler (port 6543). Jangan gunakan Session Pooler port 5432 untuk Vercel:
# batas client session yang kecil akan habis saat function diskalakan.
# Jika perlu, gunakan koneksi direct/session khusus untuk operasi migrasi manual.
# Vercel membatasi pool aplikasi ke 1 koneksi/function dan idle 5 detik.
# TLS otomatis `require` di produksi, jadi DATABASE_SSL tidak perlu diset.
DATABASE_URL=

# ============================== EMAIL (SMTP) =================================
# Dipakai untuk OTP verifikasi dan email reset password. Tanpa SMTP aplikasi
# tetap jalan, tetapi secara jujur melaporkan email belum terkirim (tidak
# berpura-pura berhasil).
SMTP_HOST=                            # contoh: smtp.gmail.com
SMTP_PORT=587                        # 587 memakai STARTTLS; port 465 otomatis memakai TLS
SMTP_USER=                            # akun SMTP; wajib dipasangkan dengan SMTP_PASS
SMTP_PASS=
SMTP_FROM=                            # opsional jika SMTP_USER diisi; default ke alamat SMTP_USER

# ============================== CLOUDFLARE TURNSTILE =========================
# Opsional. Isi KEDUA key → widget captcha langsung aktif di login, daftar,
# dan lupa password (server fail-closed). Kosongkan keduanya → widget tidak
# muncul sama sekali dan form berjalan normal.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ============================== GOOGLE OAUTH =================================
# Opsional. Isi client ID + secret → tombol "Lanjutkan dengan Google" muncul
# otomatis. Callback diturunkan dari APP_URL, jadi daftarkan URI berikut di
# Google Cloud Console → Credentials:
#   <APP_URL>/api/auth/google/callback
# Kosongkan keduanya → tombol tidak dirender. Email Google harus terverifikasi.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================== SUPPLIER (TeleKos) ===========================
# Sumber katalog & nomor virtual. Tanpa API key, SUPPLIER_MODE otomatis `off`
# dan halaman publik menampilkan keadaan "data belum tersedia" apa adanya.
TELEKOS_API_KEY=
# Secret tanda tangan webhook (X-Telekos-Signature). Opsional bila hanya
# memakai cron polling; isi jika webhook supplier akan digunakan. Tanpa secret,
# endpoint webhook menolak request (503) agar tidak menerima event tanpa verifikasi.
TELEKOS_WEBHOOK_SECRET=

# ============================== PAYMENT (AstraPay) ===========================
# Disabled by default. To enable, configure all three values and use a public
# HTTPS APP_URL so AstraPay can reach /api/webhooks/astrapay. Keep credentials
# until pending invoices settle/expire, even if you set ASTRAPAY_ENABLED=false.
# Never put these
# values in frontend code, public config, logs, or Git. Rotate any key that has
# been shared in chat or a screenshot before adding it here.
ASTRAPAY_ENABLED=false
ASTRAPAY_PROJECT_SLUG=
ASTRAPAY_API_KEY=
ASTRAPAY_WEBHOOK_SECRET=
ASTRAPAY_EXPIRES_IN=600              # Provider allows 300–600 seconds

# ============================== SECURITY =====================================
# Wajib di produksi (min. 16 karakter). Melindungi endpoint /api/cron/*.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=
