# ============================================================================
# FINZZ Store — environment template
#
# Copy to .env for local use, or load from /etc/finzz/finzz.env on a VPS.
# NEVER commit real values. NEVER expose these to the browser: everything here
# is read by the server only. The single exception is TURNSTILE_SITE_KEY, which
# is public by design and is republished through /api/public/config.
#
# Production boot refuses to start when a mandatory value is missing
# (src/config.js). That is intentional: a silently degraded deployment is worse
# than a failed deploy.
# ============================================================================

# ---------------------------------------------------------------- runtime ---
NODE_ENV=production                  # production | development | test
PORT=3000
HOST=0.0.0.0
APP_URL=https://finzz.example.com    # must be https:// in production
ALLOWED_ORIGINS=https://finzz.example.com
TRUST_PROXY=true                     # behind Cloudflare Tunnel / Vercel
LOG_LEVEL=info                       # debug | info | warn | error
STORE_NAME=FINZZ Store               # used in email subjects and headers

# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# ------------------------------------------------------------- PostgreSQL ---
# The application talks to PostgreSQL directly (pg driver, pooled, parameterised).
# Supabase Auth and the supabase-js data layer are no longer used.
#
# Local:      postgres://finzz:password@127.0.0.1:5432/finzz
# Supabase:   Project Settings → Database → Connection string → URI
#             (use the pooler host on port 6543 for serverless)
DATABASE_URL=
DATABASE_SSL=require                 # require | no-verify | disable
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT=10000    # ms to obtain a connection
DATABASE_IDLE_TIMEOUT=30000          # ms before an idle client is closed
DATABASE_STATEMENT_TIMEOUT=15000     # ms, per statement
# No SUPABASE_* variable is read by this build. SUPABASE_DB_URL (the old alias)
# was removed on purpose: a silent fallback hides a broken deployment.

# ----------------------------------------------------------------- session --
SESSION_COOKIE_NAME=fz_session
CSRF_COOKIE_NAME=fz_csrf
SESSION_TTL_SECONDS=604800

# -------------------------------------------------------------------- auth --
# Custom auth: Argon2id + emailed one-time codes. No external provider.
AUTH_REQUIRE_EMAIL_VERIFICATION=true # must stay true in production
AUTH_OTP_TTL_SECONDS=600             # 6-digit code lifetime (5–10 min)
AUTH_RESET_TTL_SECONDS=600           # reset link lifetime — exactly 10 minutes
AUTH_TOKEN_MAX_ATTEMPTS=5            # wrong-code attempts before the code burns
AUTH_MAX_FAILED_LOGINS=5             # failed logins before a temporary lock
AUTH_LOCK_SECONDS=900
# Development only. Production refuses to boot with this enabled.
AUTH_EXPOSE_DEV_TOKENS=false

# -------------------------------------------------------------------- SMTP --
# Without SMTP the app still works, but registration says honestly that the
# verification email was NOT sent (emailSent:false) instead of pretending.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false                    # true for implicit TLS (465)
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FINZZ Store <no-reply@finzz.example.com>"
SMTP_TIMEOUT_MS=10000

# -------------------------------------------------- Cloudflare Turnstile ----
# Optional. When enabled it fails closed: a missing or invalid token is rejected.
# Leave TURNSTILE_ENABLED=false to hide the widget entirely.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=finzz.example.com
TURNSTILE_TIMEOUT_MS=5000

# ------------------------------------------------------------ Google OAuth --
# Optional. The login button only appears when this is fully configured.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://finzz.example.com/api/auth/google/callback

# ---------------------------------------------------------------- supplier --
SUPPLIER_MODE=live                   # live | mock | off   (mock is refused in production)
TELEKOS_BASE_URL=https://telekos.id/v1
TELEKOS_API_KEY=                     # server-side only, never sent to the browser
TELEKOS_WEBHOOK_SECRET=              # X-Telekos-Signature = t=unix,v1=HMAC_SHA256(timestamp.raw_body)
TELEKOS_TIMEOUT_MS=12000

# ------------------------------------------------------------------- cron ---
# Scheduled work is triggered from outside the process (cron-job.org or Vercel
# Cron). CRON_SECRET is mandatory in production, minimum 16 characters.
#   Authorization: Bearer $CRON_SECRET
CRON_SECRET=
CRON_LOCK_TTL_SECONDS=120

# ------------------------------------------------------------------- jobs ---
# In-process timers are for local development and a long-lived VPS only. On
# serverless (Vercel) set JOBS_ENABLED=false and let /api/cron/* do the work.
JOBS_ENABLED=true
ORDER_POLLER_ENABLED=true
RECONCILIATION_ENABLED=true
ORDER_POLL_INTERVAL_MS=15000         # server polls the supplier every 15s
ORDER_POLL_BATCH=20
ORDER_POLL_LEASE_SECONDS=45
RECONCILE_INTERVAL_MS=60000
CATALOG_BOOT_DELAY_MS=20000          # wait before the first catalogue sync at boot

# ----------------------------------------------------------------- limits ---
MAX_BODY_BYTES=65536
MAX_JSON_BYTES=524288
MAX_UPLOAD_BYTES=5242880             # 5 MB deposit proof
UPLOAD_DIR=./storage                 # private, outside the web root

# ------------------------------------------------------- payment gateway ----
# The gateway adapter is intentionally inactive until an owner-approved
# provider contract exists. Leaving these empty keeps automatic top-ups off and
# the UI shows "pembayaran otomatis belum aktif".
PAYMENT_PROVIDER=
PAYMENT_MODE=disabled
PAYMENT_SECRET=

# Optional: reported by /api/health and the footer.
APP_VERSION=2.0.0

# ---------------------------------------------------------------- demo ------
# DEMO_MODE uses the in-memory database and seeds two published accounts.
# config.js refuses to start with DEMO_MODE=true when NODE_ENV=production.
DEMO_MODE=false

# Preview accounts created automatically in demo mode. Set DEMO_SEED=false to
# skip them. The credentials are published through /api/public/config (so the
# login page can show them) ONLY when the process is a non-production demo.
DEMO_SEED=true
DEMO_ADMIN_EMAIL=admin@finzz.store
DEMO_ADMIN_PASSWORD=FinzzDemo#2026
DEMO_USER_EMAIL=demo@finzz.store
DEMO_USER_PASSWORD=FinzzDemo#2026
